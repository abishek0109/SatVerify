# SatVerify Environment Configuration Example
# Copy to .env and adjust variables as needed

# Application settings
SATVERIFY_ENV=development
SATVERIFY_LOG_LEVEL=INFO

# Decision Engine Thresholds
SATVERIFY_REAL_THRESHOLD=0.38
SATVERIFY_FAKE_THRESHOLD=0.62

# Optional Geospatial API Keys (Not required for standard local operations)
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
